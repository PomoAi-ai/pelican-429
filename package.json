{
  "name": "pelican-429",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:full": "vite build --mode full --outDir dist-full",
    "assets:web": "node scripts/build-web-models.ts",
    "assets:ktx2": "node scripts/build-web-models.ts --ktx2",
    "assets:web-1k": "node scripts/build-web-models.ts --web-1k",
    "assets:ktx2-256": "node scripts/build-web-models.ts --ktx2-256",
    "assets:compact": "node scripts/build-compact-models.ts",
    "assets:scene": "node scripts/build-scene-assets.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "docs:resources": "node scripts/build-material-library.ts && node scripts/build-llms.ts",
    "predev": "npm run docs:resources",
    "prebuild": "npm run docs:resources",
    "prebuild:full": "npm run docs:resources"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "marked": "^18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "meshoptimizer": "0.22.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
