#!/bin/sh
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "提交被阻止：请先安装 Gitleaks 并加入 PATH，参见 docs/git-security.md。" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --config .gitleaks.toml --redact --ignore-gitleaks-allow --verbose --no-banner
exec gitleaks git --pre-commit --staged --config .gitleaks-metadata.toml --redact --ignore-gitleaks-allow --verbose --no-banner
